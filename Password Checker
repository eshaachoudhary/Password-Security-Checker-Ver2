#!/usr/bin/env python3
"""
Password Security Checker
--------------------------
Analyzes password strength using multiple criteria:
  - Length
  - Character variety (upper/lower/digits/symbols)
  - Common password / dictionary word detection
  - Entropy estimation
  - Pwned password check via Have I Been Pwned API (k-anonymity model,
    so the full password is NEVER sent over the network)

Usage:
    python password_checker.py
    python password_checker.py --password "MySecret123!"
    python password_checker.py --no-online   # skip the HIBP network check
"""

import argparse
import getpass
import hashlib
import math
import re
import sys
import urllib.request
import urllib.error

# A small built-in list of extremely common / weak passwords.
# For a real project you'd load a much larger list (e.g. rockyou.txt-derived,
# or SecLists) from a file instead of hardcoding it.
COMMON_PASSWORDS = {
    "123456", "123456789", "qwerty", "password", "12345", "12345678",
    "111111", "1234567", "sunshine", "iloveyou", "admin", "welcome",
    "monkey", "login", "abc123", "starwars", "123123", "dragon",
    "passw0rd", "master", "hello", "freedom", "whatever", "qazwsx",
    "trustno1", "letmein", "football", "baseball", "shadow", "superman",
}


def calculate_entropy(password: str) -> float:
    """Estimate password entropy in bits based on character pool size."""
    pool = 0
    if re.search(r"[a-z]", password):
        pool += 26
    if re.search(r"[A-Z]", password):
        pool += 26
    if re.search(r"[0-9]", password):
        pool += 10
    if re.search(r"[^a-zA-Z0-9]", password):
        pool += 32  # rough estimate for common symbol set

    if pool == 0 or len(password) == 0:
        return 0.0

    return len(password) * math.log2(pool)


def check_pwned(password: str, timeout: int = 5):
    """
    Check the password against the Have I Been Pwned database using the
    k-anonymity API: only the first 5 characters of the SHA-1 hash are
    sent to the API, never the password or the full hash.

    Returns:
        int  -> number of times seen in breaches (0 if not found)
        None -> lookup failed (network issue, timeout, etc.)
    """
    sha1 = hashlib.sha1(password.encode("utf-8")).hexdigest().upper()
    prefix, suffix = sha1[:5], sha1[5:]

    url = f"https://api.pwnedpasswords.com/range/{prefix}"
    req = urllib.request.Request(url, headers={"User-Agent": "password-security-checker"})

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8")
    except (urllib.error.URLError, TimeoutError):
        return None

    for line in body.splitlines():
        hash_suffix, count = line.split(":")
        if hash_suffix == suffix:
            return int(count)
    return 0


def analyze_password(password: str, check_online: bool = True) -> dict:
    """Run all checks and return a results dictionary."""
    results = {
        "length": len(password),
        "has_lower": bool(re.search(r"[a-z]", password)),
        "has_upper": bool(re.search(r"[A-Z]", password)),
        "has_digit": bool(re.search(r"[0-9]", password)),
        "has_symbol": bool(re.search(r"[^a-zA-Z0-9]", password)),
        "is_common": password.lower() in COMMON_PASSWORDS,
        "has_repeats": bool(re.search(r"(.)\1{2,}", password)),  # aaa, 111, etc.
        "has_sequence": _has_sequential_chars(password),
        "entropy": calculate_entropy(password),
    }

    if check_online:
        results["pwned_count"] = check_pwned(password)
    else:
        results["pwned_count"] = None

    results["score"], results["verdict"] = _score_password(results)
    return results


def _has_sequential_chars(password: str, run_length: int = 3) -> bool:
    """Detect ascending/descending runs like 'abcd' or '4321'."""
    lower = password.lower()
    for i in range(len(lower) - run_length + 1):
        chunk = lower[i:i + run_length]
        codes = [ord(c) for c in chunk]
        ascending = all(codes[j] + 1 == codes[j + 1] for j in range(len(codes) - 1))
        descending = all(codes[j] - 1 == codes[j + 1] for j in range(len(codes) - 1))
        if ascending or descending:
            return True
    return False


def _score_password(r: dict):
    """Combine checks into a 0-100 score and a human-readable verdict."""
    score = 0

    # Length is the single biggest factor.
    score += min(r["length"] * 4, 40)

    # Character variety.
    variety = sum([r["has_lower"], r["has_upper"], r["has_digit"], r["has_symbol"]])
    score += variety * 10

    # Entropy bonus.
    score += min(r["entropy"] / 2, 20)

    # Penalties.
    if r["is_common"]:
        score -= 50
    if r["has_repeats"]:
        score -= 10
    if r["has_sequence"]:
        score -= 10
    if r["pwned_count"]:
        score -= 50

    score = max(0, min(100, round(score)))

    if score >= 80:
        verdict = "Strong"
    elif score >= 60:
        verdict = "Moderate"
    elif score >= 35:
        verdict = "Weak"
    else:
        verdict = "Very Weak"

    return score, verdict


def print_report(password: str, r: dict):
    print("\n=== Password Security Report ===")
    print(f"Length:            {r['length']}")
    print(f"Lowercase letters: {'Yes' if r['has_lower'] else 'No'}")
    print(f"Uppercase letters: {'Yes' if r['has_upper'] else 'No'}")
    print(f"Digits:            {'Yes' if r['has_digit'] else 'No'}")
    print(f"Symbols:           {'Yes' if r['has_symbol'] else 'No'}")
    print(f"Common password:   {'Yes (bad!)' if r['is_common'] else 'No'}")
    print(f"Repeated chars:    {'Yes' if r['has_repeats'] else 'No'}")
    print(f"Sequential chars:  {'Yes' if r['has_sequence'] else 'No'}")
    print(f"Estimated entropy: {r['entropy']:.1f} bits")

    if r["pwned_count"] is None:
        print("Breach check:      skipped / unavailable")
    elif r["pwned_count"] == 0:
        print("Breach check:      not found in known breaches")
    else:
        print(f"Breach check:      FOUND in {r['pwned_count']:,} known breaches!")

    print(f"\nScore:   {r['score']}/100")
    print(f"Verdict: {r['verdict']}")
    print("=================================\n")


def main():
    parser = argparse.ArgumentParser(description="Check password strength and breach status.")
    parser.add_argument("--password", "-p", help="Password to check (omit to be prompted securely)")
    parser.add_argument("--no-online", action="store_true", help="Skip the Have I Been Pwned network check")
    args = parser.parse_args()

    password = args.password or getpass.getpass("Enter password to check: ")

    if not password:
        print("No password provided.")
        sys.exit(1)

    results = analyze_password(password, check_online=not args.no_online)
    print_report(password, results)


if __name__ == "__main__":
    main()
